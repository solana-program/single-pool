{
  "name": "@solana/spl-single-pool",
  "version": "3.0.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/solana-program/single-pool",
    "directory": "clients/js"
  },
  "main": "dist/cjs/index.js",
  "module": "dist/mjs/index.js",
  "exports": {
    ".": {
      "import": "./dist/mjs/index.js",
      "require": "./dist/cjs/index.js"
    }
  },
  "scripts": {
    "prepublishOnly": "pnpm build",
    "clean": "rm -fr dist/*",
    "build": "tsc -p tsconfig.json && tsc -p tsconfig-cjs.json && ./ts-fixup.sh",
    "test": "tsc -p tsconfig.json",
    "format": "oxfmt --check .",
    "format:fix": "oxfmt --write .",
    "lint": "oxlint --max-warnings 0",
    "lint:fix": "oxlint --fix"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@solana-program/stake": "=0.9.0",
    "@solana-program/system": "0.15.0",
    "@solana-program/token": "0.17.0",
    "@solana/kit": "8.3.0",
    "@solana/sysvars": "8.3.0"
  }
}
