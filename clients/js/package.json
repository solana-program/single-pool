{
  "name": "@solana/spl-single-pool",
  "version": "3.0.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/solana-program/single-pool",
    "directory": "clients/js"
  },
  "main": "dist/cjs/index.js",
  "module": "dist/mjs/index.js",
  "exports": {
    ".": {
      "import": "./dist/mjs/index.js",
      "require": "./dist/cjs/index.js"
    }
  },
  "scripts": {
    "prepublishOnly": "pnpm build",
    "clean": "rm -fr dist/*",
    "build": "tsc -p tsconfig.json && tsc -p tsconfig-cjs.json && ./ts-fixup.sh",
    "test": "tsc -p tsconfig.json",
    "format": "oxfmt --check .",
    "format:fix": "oxfmt --write .",
    "lint": "oxlint --max-warnings 0",
    "lint:fix": "oxlint --fix"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.75.0",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@solana/addresses": "8.2.0",
    "@solana/functional": "8.2.0",
    "@solana/instructions": "8.2.0",
    "@solana/instruction-plans": "8.2.0",
    "@solana/rpc-api": "8.2.0",
    "@solana/rpc-spec": "8.2.0",
    "@solana/transaction-messages": "8.2.0"
  }
}
